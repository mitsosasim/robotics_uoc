<launch>
 <!-- these are the arguments you can pass this launch file, for example paused:=true -->
  <arg name="paused" value="false"/>
  <arg name="verbose" value="false"/>
  <arg name="world_name" default="$(find assign3)/worlds/new_world.world"/>
  <arg name="robot" default="$(find sjtu_drone)/urdf/sjtu_drone.urdf"/>
  <!-- launch the custom world -->
   <include file="$(find gazebo_ros)/launch/empty_world.launch" >
        <arg name="paused" value="$(arg paused)"/>
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="verbose" value="$(arg verbose)"/>
   </include>

   <!-- send robot urdf to param server -->
  <param name="robot_description" textfile="$(find sjtu_drone)/urdf/sjtu_drone.urdf" />

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find assign3)/rviz/particle_visualization.rviz"/>
  <node name="drone_keyboard" pkg="sjtu_drone" type="drone_keyboard" />
</launch>
